<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ultimate_ZPL_Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ultimate_ZPL_Viewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ultimate ZPL Viewer">
    <!-- Acrylic backdrop is configured in code (DesktopAcrylicController) so the
         translucency can be tuned per theme for a clearly visible effect. -->

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <!-- Windows 11-style title bar (32 px = caption-button height, hidden in fullscreen) -->
            <RowDefinition Height="Auto"/>
            <!-- App Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Reserved for the system caption buttons (width set in code) -->
                <ColumnDefinition x:Name="CaptionSpacerColumn" Width="138"/>
            </Grid.ColumnDefinitions>

            <!-- Drag region: spans the whole bar; interactive elements sit above it -->
            <Border x:Name="DragRegion" Grid.ColumnSpan="3" Background="Transparent"/>

            <!-- Back arrow (shown in settings, far left, Windows-Settings style) -->
            <Button x:Name="TitleBarBackButton"
                    Visibility="Collapsed"
                    Width="40" Height="32"
                    Margin="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="TitleBarBackButton_Click"
                    ToolTipService.ToolTip="Retour">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>

            <!-- Settings, far left (left of the app icon) -->
            <Button x:Name="SettingsTitleButton"
                    Width="40" Height="32"
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Click="SettingsTitleButton_Click"
                    ToolTipService.ToolTip="Paramètres">
                <FontIcon Glyph="&#xE713;" FontSize="13"/>
            </Button>

            <StackPanel x:Name="TitleContent"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="48,0,0,0"
                        IsHitTestVisible="False">
                <Image Source="Assets/Square44x44Logo.scale-200.png" Width="16" Height="16"/>
                <TextBlock x:Name="AppTitleText"
                           Text="Ultimate ZPL Viewer"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Toolbar toggle + fullscreen, left of the system caption buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ToolbarToggleButton"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                        Click="ToolbarToggleButton_Click"
                        ToolTipService.ToolTip="Masquer la barre d'outils">
                    <FontIcon x:Name="ToolbarToggleIcon" Glyph="&#xE70E;" FontSize="12"/>
                </Button>
                <Button x:Name="FullScreenButton"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                        Click="FullScreenButton_Click"
                        ToolTipService.ToolTip="Plein écran">
                    <FontIcon Glyph="&#xE740;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- App content -->
        <Frame x:Name="rootFrame" Grid.Row="1"/>

        <!-- Fullscreen: thin invisible strip at the top of the screen that reveals
             the overlay bar when the mouse touches the top edge -->
        <Border x:Name="FullScreenTopEdge"
                Grid.RowSpan="2"
                Height="6"
                VerticalAlignment="Top"
                Background="Transparent"
                Visibility="Collapsed"
                Canvas.ZIndex="99"
                PointerEntered="FullScreenTopEdge_PointerEntered"/>

        <!-- Fullscreen overlay bar: minimize / exit fullscreen / close -->
        <Grid x:Name="FullScreenBar"
              Grid.RowSpan="2"
              Height="40"
              VerticalAlignment="Top"
              Visibility="Collapsed"
              Canvas.ZIndex="100"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              PointerExited="FullScreenBar_PointerExited">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        IsHitTestVisible="False">
                <Image Source="Assets/Square44x44Logo.scale-200.png" Width="16" Height="16"/>
                <TextBlock Text="Ultimate ZPL Viewer"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FsMinimizeButton"
                        Width="46" Height="40"
                        Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                        Click="FsMinimizeButton_Click"
                        ToolTipService.ToolTip="Réduire">
                    <FontIcon Glyph="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="FsExitButton"
                        Width="46" Height="40"
                        Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                        Click="FsExitButton_Click"
                        ToolTipService.ToolTip="Quitter le plein écran">
                    <FontIcon Glyph="&#xE73F;" FontSize="10"/>
                </Button>
                <Button x:Name="FsCloseButton"
                        Width="46" Height="40"
                        Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                        Click="FsCloseButton_Click"
                        ToolTipService.ToolTip="Fermer">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
