<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ultimate_ZPL_Viewer.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ultimate_ZPL_Viewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#131313"/>
                    <!-- Floating bars over the preview: a light grey plate in dark
                         mode (the editor surface would vanish into the preview
                         background), white in light mode. -->
                    <SolidColorBrush x:Key="FloatPlateBrush" Color="#2C2C2C"/>
                    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#151515"/>
                    <SolidColorBrush x:Key="PreviewGridLineBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="PreviewRulerBrush" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="PreviewRulerTickBrush" Color="#80FFFFFF"/>
                    <SolidColorBrush x:Key="PreviewRulerTextBrush" Color="#B0FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="FloatPlateBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="PreviewGridLineBrush" Color="#12000000"/>
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#40000000"/>
                    <SolidColorBrush x:Key="PreviewRulerBrush" Color="#E4E4E4"/>
                    <SolidColorBrush x:Key="PreviewRulerTickBrush" Color="#80000000"/>
                    <SolidColorBrush x:Key="PreviewRulerTextBrush" Color="#B0000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Firefox-like floating tab: a fully rounded pill with breathing room
                 all around, never glued to the bottom edge. Part names (TabContainer,
                 ContentPresenter, CloseButton) are the ones TabViewItem wires up. -->
            <Style x:Key="FloatingTabViewItemStyle" TargetType="TabViewItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabViewItem">
                            <Grid x:Name="LayoutRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabContainer.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabContainer.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="TabContainer.Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                                                <Setter Target="TabContainer.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TabContainer.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                <Setter Target="TabContainer.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TabContainer.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                <Setter Target="TabContainer.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="TabContainer"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,5,6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentPresenter"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"/>
                                        <Button x:Name="CloseButton"
                                                Grid.Column="1"
                                                Width="22" Height="22"
                                                Padding="0"
                                                Margin="10,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8BB;" FontSize="8"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Transparent root: the acrylic window backdrop shows through the title
         bar, the toolbar and the chrome around the editor/preview surfaces. -->
    <Grid x:Name="Root" RowSpacing="0" Background="Transparent"
          AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- Status strip: takes no room at all until something has progress
                 to report. The overlays above still span rows 0-2 only, so a
                 background download stays visible from the settings screen. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ToolbarBorder" Grid.Row="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <!-- Filled by RebuildToolbar from the saved layout (up to 3 lines). -->
            <StackPanel x:Name="ToolbarLines" Margin="10,8" Spacing="6"/>
        </Border>

        <!-- Document tabs: hidden while a single document is open (the title then
             moves back into the window title bar). "Nouveau fichier" / "Ouvrir un
             fichier" and the "+" button open new tabs. -->
        <!-- The whole strip (pills AND the "+" button) floats via the bottom
             margin here — the pills carry no inner margin, so everything in the
             strip stays vertically aligned by construction. -->
        <TabView x:Name="DocTabs"
                 Grid.Row="1"
                 Visibility="Collapsed"
                 VerticalAlignment="Top"
                 Margin="6,5,6,7"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 AllowDrop="True"
                 IsAddTabButtonVisible="True"
                 AddTabButtonClick="DocTabs_AddTabButtonClick"
                 TabCloseRequested="DocTabs_TabCloseRequested"
                 SelectionChanged="DocTabs_SelectionChanged"
                 TabDragStarting="DocTabs_TabDragStarting"
                 TabDroppedOutside="DocTabs_TabDroppedOutside"
                 TabStripDragOver="DocTabs_TabStripDragOver"
                 TabStripDrop="DocTabs_TabStripDrop">
            <TabView.Resources>
                <!-- Stock "+" button is 32x24 pushed down by a 3px bottom padding;
                     sized to the pill height (34) and centered instead. -->
                <x:Double x:Key="TabViewItemAddButtonWidth">34</x:Double>
                <x:Double x:Key="TabViewItemAddButtonHeight">34</x:Double>
                <Thickness x:Key="TabViewItemAddButtonContainerPadding">4,0,0,0</Thickness>
            </TabView.Resources>
        </TabView>

        <!-- Holder for the toolbar groups; RebuildToolbar reparents them into the
             lines above. The download/print buttons keep their per-group styling. -->
        <Grid x:Name="ToolbarItemHolder" Grid.Row="0" Visibility="Collapsed">
            <StackPanel x:Name="FileGroup" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="NewFileButton" Click="NewFileButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <TextBlock x:Name="NewFileText" Text="Nouveau fichier"/>
                    </StackPanel>
                </Button>
                <!-- Primary click opens the picker; the dropdown lists recent files.
                     A SplitButton keeps this on one line (no extra toolbar button). -->
                <SplitButton x:Name="OpenFileButton" Click="OpenFileButton_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="14"/>
                        <TextBlock x:Name="OpenFileText" Text="Ouvrir un fichier"/>
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="RecentFilesFlyout" Placement="Bottom"/>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton x:Name="SaveButton" Click="SaveButton_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock x:Name="SaveText" Text="Enregistrer"/>
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="Enregistrer sous…" Click="SaveAsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>

            <StackPanel x:Name="DensityGroup" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80A;" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="DensityLabel" Text="Densité :" VerticalAlignment="Center"/>
                <ComboBox x:Name="DensityComboBox" Width="185" SelectionChanged="DensityComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel x:Name="SizeGroup" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE740;" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="SizeLabel" Text="Taille :" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthBox" Width="58" TextChanging="SizeBox_TextChanging" InputScope="Number"/>
                <FontIcon x:Name="WidthWarningIcon" Glyph="&#xE7BA;" FontSize="14" Foreground="#E0A000"
                          Visibility="Collapsed" VerticalAlignment="Center"
                          ToolTipService.ToolTip="La largeur dépasse 50 cm : l'aperçu est limité à 50 cm."/>
                <TextBlock x:Name="UnitLabel1" Text="mm" VerticalAlignment="Center"/>
                <TextBlock Text="x" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightBox" Width="58" TextChanging="SizeBox_TextChanging" InputScope="Number"/>
                <FontIcon x:Name="HeightWarningIcon" Glyph="&#xE7BA;" FontSize="14" Foreground="#E0A000"
                          Visibility="Collapsed" VerticalAlignment="Center"
                          ToolTipService.ToolTip="La hauteur dépasse 50 cm : l'aperçu est limité à 50 cm."/>
                <TextBlock x:Name="UnitLabel2" Text="mm" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Rotate group: a SplitButton (90° on click + a flyout for a custom angle). -->
            <StackPanel x:Name="RotateGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <SplitButton x:Name="RotateSplitButton" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7AD;" FontSize="14"/>
                        <TextBlock x:Name="RotateText" Text="Tourner"/>
                    </StackPanel>
                    <SplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBox x:Name="RotationBox" Width="80"
                                         InputScope="Number" PlaceholderText="0"
                                         TextChanging="RotationBox_TextChanging"/>
                                <TextBlock Text="°" VerticalAlignment="Center" FontSize="16"/>
                            </StackPanel>
                        </Flyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>

            <!-- Preview zoom: a single spin control [− | 100 % | +] (steps of 10 %,
                 manual entry allowed; 20 % .. max zoomable) plus the reset button. -->
            <StackPanel x:Name="ZoomGroup" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="ZoomSpin"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ZoomMinusButton"
                                Padding="9,0"
                                VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="4,0,0,4"
                                ToolTipService.ToolTip="Zoom arrière (−10 %, maintenir pour accélérer)">
                            <FontIcon Glyph="&#xE71F;" FontSize="13"/>
                        </Button>
                        <TextBox x:Name="ZoomValueBox"
                                 Width="62"
                                 Padding="4,5,4,6"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 TextAlignment="Center"
                                 InputScope="Number"
                                 Text="100 %"/>
                        <Button x:Name="ZoomPlusButton"
                                Padding="9,0"
                                VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="0,4,4,0"
                                ToolTipService.ToolTip="Zoom avant (+10 %, maintenir pour accélérer)">
                            <FontIcon Glyph="&#xE8A3;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Name="ZoomResetButton"
                        Padding="6,5"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Réinitialiser le zoom (100 %)">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
            </StackPanel>

            <StackPanel x:Name="DownloadGroup" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                </StackPanel.Resources>
                <Button x:Name="PdfButton" Click="PdfButton_Click"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xF000;" FontSize="14"/>
                        <TextBlock x:Name="PdfText" Text="PDF"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PngButton" Click="PngButton_Click"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE91B;" FontSize="14"/>
                        <TextBlock x:Name="PngText" Text="PNG"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="PrintGroup" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="PrintButton" Click="PrintButton_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" FontSize="14"/>
                        <TextBlock x:Name="PrintText" Text="Imprimer"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">
            <!-- Left/right columns swap roles when the editor and preview are
                 swapped; the editor's column is fixed-width, the preview's is star. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Editor keeps its margins; the preview is edge-to-edge. -->
            <Grid x:Name="EditorHost"
                  Margin="14,14,0,14"
                  BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Surface painted by a Border child: a Grid's own Background is
                     not clipped by its CornerRadius at the corners, a Border's is. -->
                <Border Grid.RowSpan="3"
                        Background="{ThemeResource EditorSurfaceBrush}"
                        CornerRadius="9"/>

                <!-- 4px inset: the browser surface cannot be made transparent nor
                     clipped from XAML, so its square corners must sit entirely
                     inside the card's rounded fill (radius 9: a corner inset by 4
                     is within the arc). The gap shows the Border fill below, which
                     matches the page background. -->
                <WebView2 x:Name="EditorWebView" Grid.Row="0" Margin="4"/>

                <!-- Floating diagnostics buttons in the top-right corner (IDE style).
                     They float ABOVE the editor, so they would sit on top of the
                     minimap and swallow its clicks: the margin is recomputed in code
                     from the width Monaco reports for its right-hand chrome, and the
                     bar dims while text runs underneath (see ApplyEditorFloatBar). -->
                <Border x:Name="EditorFloatBar"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,12,0"
                        Canvas.ZIndex="10"
                        CornerRadius="6"
                        Padding="3"
                        Background="{ThemeResource EditorSurfaceBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <StackPanel.Resources>
                            <!-- Neutral checked state (no Windows accent color), clearly
                                 distinct but not glaring, tuned per theme -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlStrongFillColorDisabledBrush"/>
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlStrongFillColorDisabledBrush"/>
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush"/>
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlStrongStrokeColorDefaultBrush"/>
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlStrongStrokeColorDefaultBrush"/>
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlStrongStrokeColorDefaultBrush"/>
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#8A000000"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#8A000000"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#66000000"/>
                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF"/>
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlStrongStrokeColorDefaultBrush"/>
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlStrongStrokeColorDefaultBrush"/>
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlStrongStrokeColorDefaultBrush"/>
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <ToggleButton x:Name="DocBadge"
                                      Padding="6,2"
                                      MinHeight="28"
                                      MinWidth="36"
                                      Click="DocBadge_Click"
                                      ToolTipService.ToolTip="Documentation de la commande sous le curseur">
                            <FontIcon Glyph="&#xE7C3;" FontSize="12"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ErrorBadge"
                                      Visibility="Collapsed"
                                      Padding="6,2"
                                      MinHeight="28"
                                      Click="DiagBadge_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="#E81123"/>
                                <TextBlock x:Name="ErrorBadgeCount" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="WarningBadge"
                                      Visibility="Collapsed"
                                      Padding="6,2"
                                      MinHeight="28"
                                      Click="DiagBadge_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#FFB900"/>
                                <TextBlock x:Name="WarningBadgeCount" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="LowWarningBadge"
                                      Visibility="Collapsed"
                                      Padding="6,2"
                                      MinHeight="28"
                                      Click="DiagBadge_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#4CA0E0"/>
                                <TextBlock x:Name="LowWarningBadgeCount" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                        BorderThickness="0,1,0,0"
                        Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Drag handle: resizes the diagnostics panel vertically -->
                        <local:CursorGrid x:Name="ErrorPanelSplitter"
                                          Height="10"
                                          Background="Transparent">
                            <Rectangle Height="2"
                                       RadiusX="1" RadiusY="1"
                                       Width="32"
                                       Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </local:CursorGrid>
                        <ListView x:Name="ErrorList"
                                  Grid.Row="1"
                                  Height="140"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ErrorList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="Padding" Value="10,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Documentation of the command under the caret -->
                <Border x:Name="DocPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                        BorderThickness="0,1,0,0"
                        Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:CursorGrid x:Name="DocPanelSplitter"
                                          Height="10"
                                          Background="Transparent">
                            <Rectangle Height="2"
                                       RadiusX="1" RadiusY="1"
                                       Width="32"
                                       Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </local:CursorGrid>
                        <ScrollViewer x:Name="DocScroll"
                                      Grid.Row="1"
                                      Height="200"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DocContent" Padding="12,2,12,12" Spacing="8"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor/preview boundary: a thin, full-height strip that RESIZES the
                 editor. It is hidden along with the editor - there is nothing left
                 to resize then, and it would sit under the collapse handle. -->
            <local:CursorGrid x:Name="EditorSplitter"
                              Grid.Column="1"
                              Width="14"
                              Background="Transparent">
                <Rectangle x:Name="SplitterHairline"
                           Width="1"
                           Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                           Opacity="0.5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"/>
            </local:CursorGrid>

            <!-- Collapse handle. It NEVER moves: it is pinned to the window edge on
                 the editor's side (left, or right when the panes are swapped) and
                 spans every column so it stays there whether the editor is shown -
                 riding in the 14px gutter its margin leaves - or hidden. Only the
                 chevron flips: it points toward the editor to collapse it, away to
                 bring it back. -->
            <local:CursorGrid x:Name="EditorCollapseHandle"
                              Grid.Column="0" Grid.ColumnSpan="3"
                              Canvas.ZIndex="20"
                              Width="14"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              Tapped="EditorCollapseHandle_Tapped">
                <Border x:Name="EditorCollapseChip"
                        Width="14" Height="44"
                        CornerRadius="4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <FontIcon x:Name="EditorCollapseChevron"
                              Glyph="&#xE76B;" FontSize="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </local:CursorGrid>

            <!-- Preview fills its column: no margin, no rounded corners, flush
                 against the splitter (left), the toolbar border (top) and the
                 window edges (right/bottom). -->
            <Border x:Name="PreviewSurface"
                    Grid.Column="2"
                    Background="{ThemeResource PreviewSurfaceBrush}">
                <!-- The rulers OVERLAY the preview edges (they do not consume layout
                     space), so toggling them never shifts the preview, its grid, or
                     the label — everything stays put and aligned. -->
                <Grid x:Name="PreviewLayoutGrid">
                    <!-- CursorGrid: shows the pan hand cursor (ScrollViewer is sealed,
                         so the cursor is owned by this parent). Fills the surface. -->
                    <local:CursorGrid x:Name="PreviewCursorHost">
                        <!-- Optional background grid (toggled in the settings) -->
                        <Canvas x:Name="PreviewGridCanvas" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PreviewScrollViewer"
                                      ZoomMode="Enabled"
                                      MinZoomFactor="0.1"
                                      MaxZoomFactor="20"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Auto"
                                      Background="Transparent">
                            <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <!-- Size / DPI summary. Rendered in code as a Composition sprite
                             whose colour is the live pixel-inverse of whatever is behind
                             it (see BuildCaptionVisual / SetCaptionText). -->
                        <Grid x:Name="CaptionHost"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,14,10"
                              IsHitTestVisible="False"/>
                    </local:CursorGrid>

                    <!-- Rulers, drawn ON TOP of the preview at the top / left edges.
                         Sized/positioned in code (ApplyRulerVisibility). -->
                    <Canvas x:Name="RulerTopCanvas"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="{ThemeResource PreviewRulerBrush}"
                            Height="22" IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <Canvas x:Name="RulerLeftCanvas"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Background="{ThemeResource PreviewRulerBrush}"
                            Width="22" IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <!-- Corner covering the top-left intersection (both rulers on). -->
                    <Border x:Name="RulerCorner"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="22" Height="22"
                            Background="{ThemeResource PreviewRulerBrush}"
                            Visibility="Collapsed"/>

                    <!-- Insertion toolbar, edit mode only: a floating plate down
                         the LEFT edge of the preview, the way every drawing tool
                         puts it. Clicking a tool arms it; the next click on the
                         label places the element (drag to size the shapes). The
                         armed tool is filled with the accent, like the mode plate.
                         Icons are DRAWN rather than taken from the icon font: there
                         is no barcode glyph in it, and a half-drawn set would read
                         worse than a consistent one. -->
                    <Border x:Name="EditToolbar"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="24,10,0,0"
                            Canvas.ZIndex="30"
                            Visibility="Collapsed"
                            CornerRadius="8"
                            Padding="4"
                            Background="{ThemeResource FloatPlateBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <StackPanel.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </StackPanel.Resources>
                            <Button x:Name="ToolSelectButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <Path x:Name="ToolSelectIcon"
                                      Width="12" Height="14" Stretch="Uniform"
                                      Data="M 0,0 L 0,13 L 3.4,9.8 L 5.6,14 L 7.8,12.9 L 5.6,8.9 L 10,8.6 Z"/>
                            </Button>
                            <!-- Selecting and moving are two tools, not one. The
                                 arrow only picks things up to look at them; the
                                 cross-arrows are what lets a drag change the label.
                                 A guard against nudging an element while reading it. -->
                            <Button x:Name="ToolMoveButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <Path x:Name="ToolMoveIcon"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Data="M8,0 L11,3 L9,3 L9,7 L13,7 L13,5 L16,8 L13,11 L13,9 L9,9 L9,13 L11,13 L8,16 L5,13 L7,13 L7,9 L3,9 L3,11 L0,8 L3,5 L3,7 L7,7 L7,3 L5,3 Z"/>
                            </Button>
                            <Rectangle Height="1" Margin="5,2"
                                       Fill="{ThemeResource SurfaceStrokeBrush}"/>
                            <Button x:Name="ToolTextButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <TextBlock x:Name="ToolTextIcon" Text="T"
                                           FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="ToolCodeButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <StackPanel x:Name="ToolCodeIcon" Orientation="Horizontal"
                                            Height="13" VerticalAlignment="Center">
                                    <Rectangle Width="1.5" Margin="0,0,1.5,0"/>
                                    <Rectangle Width="3" Margin="0,0,1.5,0"/>
                                    <Rectangle Width="1.5" Margin="0,0,1.5,0"/>
                                    <Rectangle Width="1.5" Margin="0,0,1.5,0"/>
                                    <Rectangle Width="3"/>
                                </StackPanel>
                            </Button>
                            <!-- Two overlapping outlines rather than a rectangle:
                                 the button covers rectangles, lines, ellipses and
                                 circles, and a single rectangle claimed only one. -->
                            <Button x:Name="ToolShapeButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <Canvas Width="15" Height="14">
                                    <Ellipse x:Name="ToolShapeIconEllipse"
                                             Canvas.Left="5" Canvas.Top="0"
                                             Width="10" Height="10" StrokeThickness="1.3"
                                             Fill="Transparent"/>
                                    <Rectangle x:Name="ToolShapeIconRect"
                                               Canvas.Left="0" Canvas.Top="4"
                                               Width="10" Height="10" StrokeThickness="1.3"
                                               Fill="Transparent"/>
                                </Canvas>
                            </Button>
                            <Button x:Name="ToolFillButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <Rectangle x:Name="ToolFillIcon" Width="14" Height="11" StrokeThickness="0"/>
                            </Button>
                            <!-- A frame with a sun and a hill in it: the picture
                                 everybody reads as "an image", drawn rather than
                                 borrowed so it matches the rest of the plate. -->
                            <Button x:Name="ToolImageButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0" CornerRadius="6">
                                <Canvas Width="16" Height="13">
                                    <Rectangle x:Name="ToolImageIconFrame"
                                               Width="16" Height="13" RadiusX="1.5" RadiusY="1.5"
                                               StrokeThickness="1.3" Fill="Transparent"/>
                                    <Ellipse x:Name="ToolImageIconSun"
                                             Canvas.Left="3.2" Canvas.Top="2.8"
                                             Width="2.6" Height="2.6" StrokeThickness="0"/>
                                    <Path x:Name="ToolImageIconHill"
                                          Canvas.Left="1.6" Canvas.Top="4.6" StrokeThickness="0"
                                          Data="M0,6.4 L3.4,1.6 L6.2,5.2 L8.2,3.2 L12.8,6.4 Z"/>
                                </Canvas>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Tools attached to the current selection in edit mode.
                         They live HERE, in screen space, rather than on the canvas:
                         the canvas is in label dots and the ScrollViewer scales it,
                         so a button parented there would grow and shrink with the
                         zoom. Placed by UpdateSelectionTools. -->
                    <Canvas x:Name="EditOverlay" Canvas.ZIndex="25">
                        <!-- Resize handles. Filled at run time (PreviewPage.Resize.cs)
                             and kept HERE, in screen space, so they stay the same
                             size to the eye however far the preview is zoomed. -->
                        <Canvas x:Name="ResizeHandles"/>
                        <Border x:Name="SelectionTools"
                                Visibility="Collapsed"
                                CornerRadius="6"
                                Padding="3"
                                Background="{ThemeResource FloatPlateBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <StackPanel.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                </StackPanel.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="RotateElementButton"
                                            Width="28" Height="26" MinWidth="0" Padding="0"
                                            CornerRadius="5">
                                        <FontIcon Glyph="&#xE7AD;" FontSize="13"/>
                                    </Button>
                                    <!-- Z-order. Two overlapping squares, the one in
                                         front filled: the idiom every drawing tool
                                         uses, and there is no icon-font glyph for it. -->
                                    <Button x:Name="ForwardElementButton"
                                            Width="28" Height="26" MinWidth="0" Padding="0"
                                            CornerRadius="5">
                                        <Canvas Width="14" Height="14">
                                            <Rectangle x:Name="ForwardIconBack"
                                                       Canvas.Left="4" Canvas.Top="0"
                                                       Width="9" Height="9"
                                                       StrokeThickness="1.2" Fill="Transparent"/>
                                            <Rectangle x:Name="ForwardIconFront"
                                                       Canvas.Left="0" Canvas.Top="4"
                                                       Width="9" Height="9"/>
                                        </Canvas>
                                    </Button>
                                    <Button x:Name="BackwardElementButton"
                                            Width="28" Height="26" MinWidth="0" Padding="0"
                                            CornerRadius="5">
                                        <Canvas Width="14" Height="14">
                                            <Rectangle x:Name="BackwardIconBack"
                                                       Canvas.Left="4" Canvas.Top="0"
                                                       Width="9" Height="9"/>
                                            <Rectangle x:Name="BackwardIconFront"
                                                       Canvas.Left="0" Canvas.Top="4"
                                                       Width="9" Height="9"
                                                       StrokeThickness="1.2" Fill="Transparent"/>
                                        </Canvas>
                                    </Button>
                                    <Button x:Name="DuplicateElementButton"
                                            Width="28" Height="26" MinWidth="0" Padding="0"
                                            CornerRadius="5">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                    </Button>
                                    <Button x:Name="DeleteElementButton"
                                            Width="28" Height="26" MinWidth="0" Padding="0"
                                            CornerRadius="5">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    </Button>
                                    <!-- What the field prints. Shown for anything with
                                         a ^FD: a text, a barcode, a QR code. -->
                                    <!-- No fixed Height: the TextBox template puts its
                                         text at the TOP of the content area and
                                         ignores VerticalContentAlignment, so forcing
                                         a height only squeezed it up there. The
                                         padding gives the line its own room, and the
                                         box takes the height that follows. -->
                                    <TextBox x:Name="SelectionData"
                                             Width="170" MinHeight="0"
                                             Padding="8,5,8,5"
                                             VerticalAlignment="Center"
                                             FontSize="12"
                                             Visibility="Collapsed"/>
                                    <ComboBox x:Name="SelectionKind"
                                              MinWidth="118" Height="28" MinHeight="0"
                                              Padding="9,0,0,0"
                                              VerticalContentAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontSize="12"
                                              Visibility="Collapsed"/>
                                    <!-- A graphic has nothing to change in a row of
                                         spinners: it is re-imported. The button
                                         reopens the import with the settings that
                                         made it, so a size or a threshold can be
                                         reconsidered without starting over. -->
                                    <Button x:Name="EditImageButton"
                                            Width="28" Height="26" MinWidth="0" Padding="0"
                                            CornerRadius="5"
                                            Visibility="Collapsed">
                                        <FontIcon Glyph="&#xE712;" FontSize="13"/>
                                    </Button>
                                    <!-- Opens the rest of the properties INSIDE the
                                         plate, as a second row. A flyout put them on
                                         top of the very element being edited. -->
                                    <ToggleButton x:Name="SelectionMoreButton"
                                                  Width="28" Height="28" MinWidth="0" Padding="0"
                                                  CornerRadius="5"
                                                  Visibility="Collapsed">
                                        <FontIcon x:Name="SelectionMoreIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="SelectionCoords"
                                               FontSize="11"
                                               Margin="2,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <!-- The rest of the properties. Part of the plate,
                                     so opening them pushes it further up and never
                                     covers what is being edited. -->
                                <StackPanel x:Name="SelectionProps"
                                            Visibility="Collapsed"
                                            Spacing="8"
                                            Margin="6,2,6,4"/>
                                <!-- Why the symbology refuses the content, when it
                                     does. One line, under the field it is about. -->
                                <TextBlock x:Name="SelectionWarning"
                                           Visibility="Collapsed"
                                           FontSize="11"
                                           MaxWidth="320"
                                           TextWrapping="Wrap"
                                           Margin="4,0,4,2"
                                           Foreground="#FFB900"/>
                            </StackPanel>
                        </Border>
                    </Canvas>

                    <!-- View / edit switch: a floating plate at the top RIGHT of
                         the preview, stacked vertically — view above, edit below.
                         Two icons, no text; the active one is FILLED with the
                         accent colour (ApplyModeButtons swaps the accent button
                         style in, so a custom accent and the hover/pressed states
                         both follow for free). Its top margin clears the
                         horizontal ruler when that one is shown; the right one is
                         wider than the top one because the window edge is a harder
                         boundary than the toolbar above, and because the preview's
                         vertical scrollbar appears in that same strip. -->
                    <Border x:Name="ModeSwitch"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,10,24,0"
                            Canvas.ZIndex="30"
                            CornerRadius="8"
                            Padding="4"
                            Background="{ThemeResource FloatPlateBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <StackPanel.Resources>
                                <!-- The UNSELECTED button is flat: the plate is the
                                     surface, and it only lights up under the
                                     pointer. The selected one wears the accent
                                     style, whose own AccentButton* brushes are
                                     untouched by these overrides. -->
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </StackPanel.Resources>
                            <Button x:Name="ViewModeButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0"
                                    CornerRadius="6">
                                <FontIcon x:Name="ViewModeIcon" Glyph="&#xE7B3;" FontSize="15"/>
                            </Button>
                            <Button x:Name="EditModeButton"
                                    Width="34" Height="30" MinWidth="0" Padding="0"
                                    CornerRadius="6">
                                <FontIcon x:Name="EditModeIcon" Glyph="&#xE70F;" FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- One line at the very bottom, shown only while something is running:
             a label, a thin bar, the percentage, and a cancel button when the
             task can be given up. Driven by PreviewPage.Status.cs. -->
        <Border x:Name="StatusStrip"
                Grid.Row="3"
                Visibility="Collapsed"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,5">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420"/>
                <ProgressBar x:Name="StatusProgress"
                             Grid.Column="1"
                             Height="3"
                             VerticalAlignment="Center"
                             Minimum="0" Maximum="1"/>
                <TextBlock x:Name="StatusPercent"
                           Grid.Column="2"
                           FontSize="12"
                           MinWidth="38"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="StatusCancel"
                        Grid.Column="3"
                        Visibility="Collapsed"
                        Padding="6,0"
                        MinWidth="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="StatusCancel_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- First-run wizard. Covers the whole page (toolbar, tabs, editor and
             preview) so nothing of the application shows behind it; the window
             title bar is stripped down by MainWindow.EnterOnboardingMode. Its
             content is built by OnboardingFlow. Sits above the settings overlay
             so the summary can hand over to the settings underneath. -->
        <Grid x:Name="OnboardingOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Canvas.ZIndex="60"/>

        <!-- Full-screen settings (PowerToys-style: categories on the left, the
             selected category's settings on the right). Covers everything below
             the title bar; the app content stays alive behind it. -->
        <Grid x:Name="SettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Canvas.ZIndex="50"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

            <NavigationView x:Name="SettingsNav"
                            PaneDisplayMode="Left"
                            IsSettingsVisible="False"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False"
                            OpenPaneLength="240"
                            SelectionChanged="SettingsNav_SelectionChanged">
                <!-- Order: Général first, workflow categories (document → output),
                     then UI customisation, hardware, and Imprimante virtuelle /
                     À propos closing the list. -->
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Général" Tag="general">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Document" Tag="doc">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Éditeur et aperçu" Tag="editor">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Impression" Tag="print">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE749;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Apparence et langue" Tag="appearance">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Barre d'outils" Tag="toolbar">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Écran" Tag="screen">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Imprimante virtuelle" Tag="printer">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE772;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="À propos" Tag="about">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0">
                    <StackPanel x:Name="SettingsContentHost" Margin="24,12,24,28" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </NavigationView>
        </Grid>
    </Grid>
</Page>
