<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ultimate_ZPL_Viewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon in the exe (taskbar, Explorer, shortcuts, installer). -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged distribution (traditional Setup.exe installer, no MSIX):
         the app no longer relies on package identity. Self-contained bundles both
         the .NET and the Windows App SDK runtimes, so the machine needs nothing
         pre-installed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Custom entry point (Program.Main) so elevated helper args are handled
         before WinUI starts (see Program.cs / VirtualPrinterService). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Disable the WindowsAppSDK auto-initializers (bootstrap + deployment manager):
         they run in a module .cctor before Main and throw (REGDB_E_CLASSNOTREG) when
         the exe is launched unpackaged — which is exactly how the elevated printer
         helper runs. Packaged launches get the runtime from the package graph, so the
         auto-initializers aren't needed. -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <!-- App unpackaged : PAS de tooling MSIX. À true, Visual Studio ajoute la
         capacité "Msix" et exige un déploiement au lancement ("The project needs
         to be deployed…"). À false, le projet se lance comme un simple .exe. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <!-- Editeur / auteur, visible dans les proprietes du fichier .exe. -->
    <Authors>Enzo Monchanin (NzoSifou)</Authors>
    <Company>Enzo Monchanin (NzoSifou)</Company>
    <Product>Ultimate ZPL Viewer</Product>
    <Copyright>© 2026 Enzo Monchanin (NzoSifou)</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="PreviewPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- Runtime assets read from AppContext.BaseDirectory\Assets. Unpackaged, they
         must be COPIED to the output (MSIX packaged them instead) or the editor and
         the languages/colour-scheme fail to load. -->
    <Content Include="Assets\editor.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\zpl_color_scheme.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\zpl_color_scheme_default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\lang_en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\lang_fr.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Copied to the output so AppWindow.SetIcon can point at it at runtime
         (window / Alt-Tab / taskbar icon). -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Title-bar icon (unpackaged: loaded by file path from the output). -->
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Resource-only native DLL carrying the pan hand cursors (open: 100,
         closed: 101), consumed via InputDesktopResourceCursor. -->
    <Content Include="ZplCursors.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="PreviewPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- ReadyToRun désactivé : en Release, R2R casse le câblage XAML des éléments
         nommés (x:Name) — plantage au démarrage « Unable to cast … to Image »
         (icône de la barre de titre). R2R n'est qu'une optimisation de démarrage. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Never trim: the app serialises AppSettings via reflection and pulls in
         WinUI/Win2D/PDFtoImage native bits that the trimmer would strip. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
